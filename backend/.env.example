# Copy to .env and fill in. Defaults work for local dev without any changes.
# NEVER commit a real .env or real credentials.

ENVIRONMENT=development          # development | production | test

# --- Database (A1) ---
# Local dev default is SQLite. In production set a PostgreSQL URL (psycopg 3):
DATABASE_URL=sqlite:///./aeomirror.db
# Production example (placeholder password — do NOT commit a real one):
# DATABASE_URL=postgresql+psycopg://aeomirror:password@localhost:5432/aeomirror
# SQLAlchemy pool (used for non-sqlite engines):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# --- Redis: shared cache + rate limiter (A3) ---
# Unset -> in-memory fallback (single process). Set in production:
# REDIS_URL=redis://localhost:6379/0

# --- Cache / rate limit ---
CACHE_TTL_SECONDS=86400          # 24h dedupe for identical URLs
FREE_SCANS_PER_WINDOW=20
RATE_LIMIT_WINDOW_SECONDS=3600   # per rolling hour, per client

# --- SSRF / proxy ---
# Keep False in prod. Tests set this True to scan a local fixture server.
ALLOW_PRIVATE_HOSTS=False
# Only True when the app runs behind a trusted proxy that sets X-Forwarded-For.
TRUST_PROXY=False

# --- Fetch limits / retry ---
FETCH_TIMEOUT_SECONDS=12
FETCH_CONNECT_TIMEOUT_SECONDS=5
FETCH_MAX_BYTES=3000000
FETCH_MAX_REDIRECTS=5
FETCH_RETRY_COUNT=2
FETCH_RETRY_BACKOFF_BASE=0.2
FETCH_RETRY_BACKOFF_MAX=2.0

# --- Bulk scan upload ---
# Hard cap (bytes) on an uploaded URL-list file (.csv/.xlsx/.txt/.json/...). The
# upload is read in bounded chunks and rejected with HTTP 413 before parsing, so a
# small zip-container file (.xlsx) can't decompress to gigabytes and OOM the worker.
BULK_UPLOAD_MAX_BYTES=2000000

# --- CORS ---
# Comma-separated exact origins allowed to call the API. Never "*". In production
# set this to your deployed frontend origin(s) only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- observability / ops ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
# Protects /debug/* admin endpoints. If unset, they are reachable only in
# non-production; in production a matching X-Admin-Token header is required.
# ADMIN_TOKEN=
# Emit HSTS header (only when served over HTTPS behind a proxy):
ENABLE_HSTS=False
# Expose interactive API docs (/docs, /redoc). Off in production by default.
# EXPOSE_DOCS=False
# Optional error tracking (Sentry). Leave blank to disable. Install sentry-sdk too.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# Production web/worker split (see render.yaml). Web: false; dedicated worker: true.
# SCHEDULER_ENABLED=True
# WEB_CONCURRENCY=2               # uvicorn workers (used by entrypoint.sh)

# --- Email: lead welcome + auth (B1, Resend) ---
# Leave blank to disable sending (lead capture + auth still work; in dev the
# verify/reset/invite links are logged so you can complete flows locally).
RESEND_API_KEY=
EMAIL_FROM=                      # e.g. "AEOMirror <hi@aeomirror.com>"
APP_BASE_URL=http://localhost:5173
# API's own public base URL (used for the digest unsubscribe link the API serves).
API_BASE_URL=http://localhost:8000

# --- Weekly digest email ---
# Backend for the digest + preflight ONLY: "resend" | "console". Unset => console
# outside production (logs the rendered email to stdout instead of calling Resend).
# EMAIL_BACKEND=
# Send window, fixed UTC (per-org timezone is out of scope). 0 = Monday.
# DIGEST_SEND_WEEKDAY=0
# DIGEST_SEND_HOUR_UTC=13

# --- Email transport: Gmail SMTP (Contact & Support) ---
# The Contact & Support system sends via Gmail SMTP (same as The Doc Mirror).
# Use a Gmail App Password (Google Account -> Security -> App passwords), NOT your
# account password. Leave blank to disable sending (submissions are still stored;
# in dev a "skipping send" line is logged). Credentials are read only from here.
GMAIL_USER=                      # e.g. aeomirror.support@gmail.com
GMAIL_APP_PASSWORD=              # 16-char Gmail App Password
# Where contact-form notifications are delivered (defaults to GMAIL_USER):
CONTACT_EMAIL=                   # e.g. aeomirror.support@gmail.com
# Optional SMTP overrides (defaults are Gmail STARTTLS):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Contact anti-spam (per IP): CONTACT_MAX_PER_WINDOW / CONTACT_RATE_WINDOW_SECONDS
# and message length bounds CONTACT_MESSAGE_MIN_LEN / CONTACT_MESSAGE_MAX_LEN.

# --- Phase 5: authentication ---
# HS256 secret used to sign JWT access tokens. REQUIRED in production (a random
# per-process secret is generated in dev). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# Token lifetimes (seconds):
# ACCESS_TOKEN_TTL_SECONDS=900            # 15 min
# REFRESH_TOKEN_TTL_SECONDS=604800        # 7 days
# REFRESH_TOKEN_REMEMBER_SECONDS=2592000  # 30 days ("remember me")
# Refresh cookie: Secure is forced True in production. SameSite=strict by default.
# AUTH_COOKIE_SECURE=False
# AUTH_COOKIE_SAMESITE=strict
# AUTH_COOKIE_DOMAIN=
# Login abuse protection (per email+IP):
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_SECONDS=900

# --- Phase 7: monitoring + scheduler ---
# In-process background worker that runs due scheduled scans. Set False to run
# scans from a SEPARATE worker process instead (future scaling); the same claim-
# based queue is drained either way. Always off under ENVIRONMENT=test.
# SCHEDULER_ENABLED=True
# SCHEDULER_INTERVAL_SECONDS=30      # worker tick cadence
# SCHEDULER_BATCH_SIZE=5             # max jobs drained per tick
# MONITOR_JOB_MAX_ATTEMPTS=3         # retries for a failed scan job
# MONITOR_JOB_RETRY_BACKOFF_SECONDS=120
# Alert thresholds:
# ALERT_SCORE_DROP_WARNING=8
# ALERT_SCORE_DROP_CRITICAL=15
# ALERT_CATEGORY_REGRESSION=15
# ALERT_CRITICAL_SCORE=25

# --- Phase 8: admin platform ---
# Comma-separated emails auto-granted platform-admin access to /admin (in addition
# to any user with is_platform_admin=True in the DB). Bootstraps the first admin.
# ADMIN_EMAILS=you@yourcompany.com

# --- Phase 9: billing + subscriptions ---
# Master switch for plan gating. True (default) enforces Free/Pro limits; set False
# to grant every org full access (billing still records, gating is bypassed).
# BILLING_ENFORCED=True
# PAYMENT_PROVIDER=stripe            # stripe | razorpay | paddle (future)
# Without STRIPE_SECRET_KEY the checkout runs in dev mode (local completion page),
# so the flow is exercisable without Stripe. Set these for real payments:
# STRIPE_SECRET_KEY=sk_live_or_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx    # verifies incoming webhooks
# STRIPE_PRICE_PRO=price_xxx         # Stripe price id for the Pro plan
# BILLING_CURRENCY=usd
# PRO_PRICE_CENTS=2900               # $29 / month
# REPORT_PRICE_CENTS=900             # $9 one-time report
# Plan limits (defaults match app/config.py; per calendar month unless noted):
# FREE_MONTHLY_SCAN_JOBS=1           # Free: scan jobs / month
# PRO_MONTHLY_SCAN_JOBS=15           # Pro: scan jobs / month
# FREE_HISTORY_LIMIT=10              # recent scans kept visible (Free)
# FREE_MONITOR_LIMIT=1               # concurrent monitors (Free)
# PRO_MONITOR_LIMIT=10               # concurrent monitors (Pro)
# FREE_MONTHLY_COMPARES=1            # scan comparisons / month (Free)

# --- AI (Anthropic): AI-written reports + content insights ---
# Leave blank to disable all AI features (the app falls back to rule-based
# reports). Get a key at console.anthropic.com and set a monthly usage cap.
# NEVER put this in frontend/.env — Vite exposes VITE_* vars to the browser.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001
# AI_MAX_TOKENS=1500
# AI_TIMEOUT_SECONDS=30
# Overall wall-clock budget (s) for the interactive "Analyze content" endpoint
# (page re-fetch + AI). Exceeding it returns 504 rather than hanging. Sized to fit the
# AI call with its one retry (2 × the interactive AI timeout below + backoff).
# CONTENT_INSIGHT_BUDGET_SECONDS=55
# Per-attempt AI timeout (s) for the interactive content-insight path only; the report
# narrative path keeps AI_TIMEOUT_SECONDS. Shorter so a retry fits the budget.
# CONTENT_INSIGHT_AI_TIMEOUT_SECONDS=20

# --- Change attribution (scan snapshots) ---
# Delete scan snapshots older than this many days (each existing monitor always keeps
# its most recent snapshot regardless of age, so its diff baseline is never lost).
# SNAPSHOT_RETENTION_DAYS=90

# --- AI Answer Tracking (Part A) ---
# Measures whether AI assistants mention/cite a brand by executing tracked prompts
# against provider APIs and storing the raw responses (NO analysis yet — that is Part B).
# Every value below is a default and can be overridden here.
# Run volume + adaptive sampling:
# ANSWER_TRACKING_MAX_PROMPTS=10          # hard cap on prompts per set (service-enforced)
# ANSWER_TRACKING_RUNS_PER_PROMPT=2       # base samples per prompt x provider
# ANSWER_TRACKING_ADAPTIVE_THIRD_RUN=true # one extra run when base runs disagree on mention
# ANSWER_TRACKING_MAX_CONCURRENCY=5       # simultaneous provider calls per run
# ANSWER_TRACKING_QUERY_TIMEOUT_SECONDS=60  # per-call wall-clock cap
# Scheduling: weekly (7d) | biweekly (14d) | monthly (30d). "biweekly" = EVERY 14 DAYS
# from the set's first run (NOT twice per week):
# ANSWER_TRACKING_FREQUENCY=biweekly
# Cost guards (OPERATIONAL limits only — NOT plan/tier gating; no billing integration):
# ANSWER_TRACKING_MIN_RUN_INTERVAL_HOURS=72   # min gap between runs of one set (admin can override)
# ANSWER_TRACKING_MONTHLY_RUN_LIMIT=8         # per-org runs per calendar month
# Search grounding: recorded per result. Results WITHOUT search measure historical
# training-data awareness, not current citation behaviour (kept as a distinct metric):
# ANSWER_TRACKING_ENABLE_SEARCH=true
# Providers enabled for a run (comma-separated). A provider listed here but missing its
# API KEY or MODEL is logged at WARNING and SKIPPED — never crashes, never silently runs
# with fewer providers than expected. perplexity + gemini are registered but OFF by
# default (re-adding one is a config change here — no code change needed):
# ANSWER_TRACKING_PROVIDERS=anthropic,openai
# Exact model strings — from env ONLY, never a floating alias like "latest". Empty => that
# provider is skipped. Stored on every result row so history stays interpretable:
# ANSWER_TRACKING_MODEL_ANTHROPIC=
# ANSWER_TRACKING_MODEL_OPENAI=
# ANSWER_TRACKING_MODEL_PERPLEXITY=
# ANSWER_TRACKING_MODEL_GEMINI=
# Per-provider flat estimated USD per call (for the pre-run estimate + stored cost).
# Placeholder defaults — tune against real provider billing:
# ANSWER_TRACKING_RATE_ANTHROPIC_USD=0.010
# ANSWER_TRACKING_RATE_OPENAI_USD=0.010
# ANSWER_TRACKING_RATE_PERPLEXITY_USD=0.010
# ANSWER_TRACKING_RATE_GEMINI_USD=0.010
# Provider API keys — BACKEND-ONLY secrets. NEVER prefix these VITE_ (Vite ships VITE_*
# vars to the browser). ANTHROPIC_API_KEY is defined above (shared with AI narratives).
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
# GEMINI_API_KEY=
# Part B — extraction/analysis. ONE cheap LLM call per stored answer produces the
# structured extraction (mention, sentiment, competitors, citations, position). Provider
# is a NAME; the model is env-only and, when unset, falls back to AI_MODEL (the existing
# cheap model) so nothing is hardcoded and extraction works wherever AI_MODEL is set.
# ANSWER_TRACKING_EXTRACTION_PROVIDER=anthropic
# ANSWER_TRACKING_EXTRACTION_MODEL=        # empty => uses AI_MODEL
# Entities EXCLUDED from competitor Share of Voice — the AI assistants / search engines
# the prompts name explicitly (the extractor otherwise lists them as competitors).
# Applied at aggregation time only; changing this never requires re-running extraction,
# and it NEVER affects brand mention detection.
# ANSWER_TRACKING_EXCLUDED_ENTITIES=ChatGPT,OpenAI,Claude,Anthropic,Gemini,Google,Bard,Perplexity,Copilot,Bing,Grok,DeepSeek,Meta AI

# ---- Paid integration keys (Steps 5/6, NOT Phase 1) — leave blank ----
# (OPENAI_API_KEY / PERPLEXITY_API_KEY are documented in the Answer Tracking section above.)
# GOOGLE_API_KEY=
# STRIPE_SECRET_KEY=
