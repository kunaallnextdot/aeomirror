# Copy to .env and fill in. Defaults work for local dev without any changes.
# NEVER commit a real .env or real credentials.

ENVIRONMENT=development          # development | production | test

# --- Database (A1) ---
# Local dev default is SQLite. In production set a PostgreSQL URL (psycopg 3):
DATABASE_URL=sqlite:///./aeomirror.db
# Production example (placeholder password — do NOT commit a real one):
# DATABASE_URL=postgresql+psycopg://aeomirror:password@localhost:5432/aeomirror
# SQLAlchemy pool (used for non-sqlite engines):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# --- Redis: shared cache + rate limiter (A3) ---
# Unset -> in-memory fallback (single process). Set in production:
# REDIS_URL=redis://localhost:6379/0

# --- Cache / rate limit ---
CACHE_TTL_SECONDS=86400          # 24h dedupe for identical URLs
FREE_SCANS_PER_WINDOW=3
RATE_LIMIT_WINDOW_SECONDS=3600   # per rolling hour, per client

# --- SSRF / proxy ---
# Keep False in prod. Tests set this True to scan a local fixture server.
ALLOW_PRIVATE_HOSTS=False
# Only True when the app runs behind a trusted proxy that sets X-Forwarded-For.
TRUST_PROXY=False

# --- Fetch limits / retry ---
FETCH_TIMEOUT_SECONDS=12
FETCH_CONNECT_TIMEOUT_SECONDS=5
FETCH_MAX_BYTES=3000000
FETCH_MAX_REDIRECTS=5
FETCH_RETRY_COUNT=2
FETCH_RETRY_BACKOFF_BASE=0.2
FETCH_RETRY_BACKOFF_MAX=2.0

# --- CORS ---
# Comma-separated exact origins allowed to call the API. Never "*". In production
# set this to your deployed frontend origin(s) only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- observability / ops ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
# Protects /debug/* admin endpoints. If unset, they are reachable only in
# non-production; in production a matching X-Admin-Token header is required.
# ADMIN_TOKEN=
# Emit HSTS header (only when served over HTTPS behind a proxy):
ENABLE_HSTS=False

# --- Email: lead welcome (B1, Resend) ---
# Leave blank to disable sending (lead capture still works). Placeholders only:
RESEND_API_KEY=
EMAIL_FROM=                      # e.g. "AEOMirror <hi@aeomirror.com>"
APP_BASE_URL=http://localhost:5173

# ---- Paid integration keys (Steps 5/6, NOT Phase 1) — leave blank ----
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# PERPLEXITY_API_KEY=
# STRIPE_SECRET_KEY=
