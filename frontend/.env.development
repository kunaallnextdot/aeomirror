# Loaded automatically by Vite in DEVELOPMENT mode only (npm run dev).
# Committed on purpose: localhost is not a secret, and because this file is
# dev-only it can NEVER leak into a production (Vercel) build.
# Production sets VITE_API_URL in the Vercel dashboard instead.
VITE_API_URL=http://localhost:8000
VITE_ENABLE_MOCK_SCANNER=false
