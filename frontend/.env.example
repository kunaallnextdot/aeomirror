# Copy to .env. Points the frontend at your backend API.
# Local dev default:
VITE_API_URL=http://localhost:8000
# Production example:
# VITE_API_URL=https://api.aeomirror.com

# Offline/demo mock scanner. Leave false (or unset) for normal operation so real
# scans never fall back to fake data. Set to true ONLY for offline UI work.
VITE_ENABLE_MOCK_SCANNER=false
