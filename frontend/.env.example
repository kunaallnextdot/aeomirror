# Frontend environment (Vite). The API base URL is read ONLY from VITE_API_URL —
# there is no hardcoded URL in the code.
#
# LOCAL DEV: works out of the box. frontend/.env.development (committed) already
#   sets VITE_API_URL=http://localhost:8000. To override for yourself, create
#   frontend/.env.local (gitignored).
# PRODUCTION (Vercel): set VITE_API_URL in the Vercel dashboard
#   (Settings -> Environment Variables), e.g. https://api.aeomirror.com.
#   Do NOT commit the production URL here. Redeploy after changing it (Vite bakes
#   env vars in at build time).

VITE_API_URL=http://localhost:8000

# Offline/demo mock scanner. Leave false (or unset) so real scans never fall back
# to fake data. Set true ONLY for offline UI work.
VITE_ENABLE_MOCK_SCANNER=false
